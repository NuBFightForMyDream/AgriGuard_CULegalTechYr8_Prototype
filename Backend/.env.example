# Leave unset to use a local SQLite file (agriguard.db).
# Docker Postgres:  postgresql+psycopg://agriguard:agriguard@localhost:5432/agriguard
# Supabase pooler:  postgres://postgres.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=

APP_ENV=local
CORS_ORIGINS=["http://localhost:3000"]
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Google sign-in via Supabase Auth (JWT verified with the project's JWKS)
SUPABASE_URL=
# Evidence uploads to Supabase Storage (server-side only, never in the frontend)
SUPABASE_SECRET_KEY=

# Demo user picker. Anyone can act as any demo user: keep for demos only.
DEMO_LOGIN=true
DEMO_SEED=true
